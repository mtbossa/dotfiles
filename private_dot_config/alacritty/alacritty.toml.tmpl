{{- /* Alacritty >= 0.14 (Arch) moved `import` under [general]; Debian's apt package is older. */ -}}
{{ if eq (includeTemplate "osFamily" .) "arch" -}}
[general]
# Follow the Omarchy theme: inside tmux, Omarchy paints panes with the theme's colors
# (omarchy-theme-set-tmux), so a different palette here shows up as a mismatched block.
import = [ "{{ .chezmoi.homeDir }}/.local/state/omarchy/current/theme/alacritty.toml" ]
{{ else -}}
import = [ "{{ .chezmoi.homeDir }}/.config/alacritty/themes/iterm.toml" ]
{{ end }}
[colors]
draw_bold_text_with_bright_colors = true
# Apply window.opacity to explicit background colors too (e.g. tmux's window-style), not just the default one.
transparent_background_colors = true

[window]
padding = { x = 20, y = 20 }
dynamic_padding = true
opacity = 0.9

{{ if eq (includeTemplate "osFamily" .) "arch" -}}
# Omarchy's size (foot uses 9 too); Alacritty's 11.25 default is too big on HiDPI-scaled laptops.
[font]
size = 9

{{ end -}}
[font.normal]
family = "JetBrainsMono Nerd Font"
style = "Regular"

[font.bold]
family = "JetBrainsMono Nerd Font"
style = "Bold"

[font.italic]
family = "JetBrainsMono Nerd Font"
style = "Italic"

[font.bold_italic]
family = "JetBrainsMono Nerd Font"
style = "Bold Italic"

[selection]
save_to_clipboard = true

[cursor.style]
shape = "Beam"

[keyboard]
bindings = [
    { key = "Return", mods = "Super|Shift", action = "SpawnNewInstance" },
]
