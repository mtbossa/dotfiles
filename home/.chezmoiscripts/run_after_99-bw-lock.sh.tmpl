{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Runs on every apply, last: if a script unlocked Bitwarden (.chezmoitemplates/bitwarden),
# lock it again and delete the cached session. Does nothing otherwise.
set -euo pipefail

BW_SESSION_FILE="/tmp/chezmoi-bw-session-${UID}"
[ -f "${BW_SESSION_FILE}" ] || exit 0

bw lock &>/dev/null || true
rm -f "${BW_SESSION_FILE}"
{{ end -}}
