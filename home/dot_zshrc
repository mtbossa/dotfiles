# shellcheck shell=bash
# ~/.zshrc: oh-my-zsh + the CLI tools shared with bash (aliases live in ~/.config/shell/aliases.sh).

export ANDROID_HOME="$HOME/Android/Sdk"
export PATH="$HOME/.local/bin:$PATH:/usr/local/bin:/sbin:$HOME/bin:$ANDROID_HOME/platform-tools:/usr/local/go/bin:/snap/bin"

# Omarchy environment (OMARCHY_PATH + PATH), same as Omarchy's own ~/.bashrc does
[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap

# Bail out for non-interactive shells. Some tools (e.g. Claude Code) spawn
# zsh subprocesses that source .zshrc anyway, which triggers spurious warnings
# from hook-based tools like zoxide's doctor check.
# Check https://github.com/venables/dotfiles/commit/fe7ee2b1b094a999f1011b843795deb4ca53ebd8
[[ $- == *i* ]] || return

# --- oh-my-zsh (installed and updated by chezmoi, see .chezmoiexternal.toml.tmpl) ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_CUSTOM="$HOME/.config/oh-my-zsh"
zstyle ':omz:update' mode disabled
plugins=(git zsh-autosuggestions zsh-syntax-highlighting docker docker-compose)

# eza zsh completions (Debian; Arch's eza package ships its own)
export FPATH="$HOME/.local/share/eza/completions/zsh:$FPATH"

source "$ZSH/oh-my-zsh.sh"

# --- CLI tools ---
command -v mise >/dev/null && eval "$(mise activate zsh)"
command -v fzf >/dev/null && source <(fzf --zsh)

# atuin (curl install lives in ~/.atuin/bin on Debian; Arch uses the package).
# Loaded after fzf so it wins the ctrl-r binding.
export PATH="$HOME/.atuin/bin:$PATH"
[[ -f "$HOME/.atuin/bin/env" ]] && . "$HOME/.atuin/bin/env"
command -v atuin >/dev/null && eval "$(atuin init zsh)"

# zoxide: `z`/`zi`, plus `cd`/`cdi` replaced by zoxide-aware versions
if command -v zoxide >/dev/null; then
    eval "$(zoxide init zsh)"
    eval "$(zoxide init zsh --cmd cd)"
fi

command -v starship >/dev/null && eval "$(starship init zsh)"
