{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# config hash: {{ .email }}|{{ .githubUser }}|{{ .chezmoi.hostname }}
set -euo pipefail

cleanup() {
    unset BW_SESSION GH_TOKEN 2>/dev/null || true
}
trap cleanup EXIT

SSH_DIR="${HOME}/.ssh"
KEY_PATH="${SSH_DIR}/id_ed25519"
KEY_COMMENT="{{ .email }}@{{ .chezmoi.hostname }}"
KEY_NAME="{{ .chezmoi.hostname }}"
GITHUB_USER="{{ .githubUser }}"

mkdir -p "${SSH_DIR}"
chmod 700 "${SSH_DIR}"

# --- 1. Generate SSH key if missing ---
if [ ! -f "${KEY_PATH}" ]; then
    echo "Generating SSH key..."
    ssh-keygen -t ed25519 -C "${KEY_COMMENT}" -f "${KEY_PATH}" -N ""
    echo "SSH key generated: ${KEY_PATH}"
else
    echo "SSH key already exists: ${KEY_PATH}"
fi

PUB_KEY_BODY=$(awk '{print $1, $2}' "${KEY_PATH}.pub")

# --- 2. Get GitHub token from Bitwarden ---
{{ template "bw-unlock" . }}

GH_TOKEN=$(bw list items --search "github-pat" --session "${BW_SESSION}" | jq -r '.[0].login.password')
if [ -z "${GH_TOKEN}" ] || [ "${GH_TOKEN}" = "null" ]; then
    echo "ERROR: Could not retrieve GitHub token from Bitwarden" >&2
    exit 1
fi
export GH_TOKEN

# Verify token works
if ! gh api /user --jq '.login' >/dev/null; then
    echo "ERROR: GitHub token is invalid or lacks permissions" >&2
    exit 1
fi

# --- 3. Register SSH key with GitHub ---

register_key() {
    local key_type="$1"      # "authentication" or "signing"
    local api_path="$2"      # "/user/keys" or "/user/ssh_signing_keys"

    local existing_id
    existing_id=$(gh api "${api_path}" --jq ".[] | select(.title == \"${KEY_NAME}\") | .id" || echo "")

    if [ -n "${existing_id}" ]; then
        local existing_key
        existing_key=$(gh api "${api_path}" --jq ".[] | select(.title == \"${KEY_NAME}\") | .key")
        if [ "${existing_key}" = "${PUB_KEY_BODY}" ]; then
            echo "GitHub ${key_type} key '${KEY_NAME}' already registered and current."
            return
        fi
        echo "Replacing stale ${key_type} key '${KEY_NAME}'..."
        gh api -X DELETE "${api_path}/${existing_id}"
    fi

    gh ssh-key add "${KEY_PATH}.pub" --title "${KEY_NAME}" --type "${key_type}"
    echo "SSH ${key_type} key registered with GitHub."
}

register_key "authentication" "/user/keys"
register_key "signing" "/user/ssh_signing_keys"

# --- 4. Create allowed_signers file ---
echo "{{ .email }} $(cat "${KEY_PATH}.pub")" > "${SSH_DIR}/allowed_signers"

# --- 5. Configure SSH for GitHub ---
if ! grep -q "Host github.com" "${SSH_DIR}/config" 2>/dev/null; then
    cat >> "${SSH_DIR}/config" <<SSHEOF

Host github.com
    HostName github.com
    User git
    IdentityFile ${KEY_PATH}
    IdentitiesOnly yes
SSHEOF
    chmod 600 "${SSH_DIR}/config"
    echo "SSH config for GitHub added."
fi

# --- 6. Switch dotfiles remote to SSH ---
CHEZMOI_DIR="{{ .chezmoi.sourceDir }}"
CURRENT_REMOTE=$(git -C "${CHEZMOI_DIR}" remote get-url origin 2>/dev/null || echo "")
if [[ "${CURRENT_REMOTE}" == https://* ]]; then
    SSH_REMOTE="git@github.com:${GITHUB_USER}/dotfiles.git"
    git -C "${CHEZMOI_DIR}" remote set-url origin "${SSH_REMOTE}"
    echo "Switched dotfiles remote to SSH: ${SSH_REMOTE}"
fi

echo ""
echo "Done. SSH key generated, registered with GitHub, git configured for SSH signing."

{{ end -}}
