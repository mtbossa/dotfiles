{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

ATUIN_BIN="${HOME}/.atuin/bin/atuin"

cleanup() {
    bw lock &>/dev/null || true
    unset BW_SESSION 2>/dev/null || true
}
trap cleanup EXIT

if [ ! -x "${ATUIN_BIN}" ]; then
    echo "ERROR: atuin is not installed at ${ATUIN_BIN}" >&2
    exit 1
fi

# Helper: get a field from a uniquely-named Bitwarden item
bw_get() {
    local item_name="$1"
    local field="$2"   # jq path, e.g. .login.password or .login.username
    bw list items --search "${item_name}" --session "${BW_SESSION}" \
        | jq -r --arg name "${item_name}" \
            '.[] | select(.name == $name) | '"${field}"
}

# --- Unlock Bitwarden ---
echo "Unlocking Bitwarden..."
if ! bw login --check &>/dev/null; then
    BW_SESSION=$(bw login --raw)
else
    BW_SESSION=$(bw unlock --raw)
fi
export BW_SESSION

# --- 1. Set sync server before login ---
ATUIN_SYNC_ADDRESS=$(bw_get "atuin-server" ".login.uris[0].uri")
if [ -z "${ATUIN_SYNC_ADDRESS}" ] || [ "${ATUIN_SYNC_ADDRESS}" = "null" ]; then
    echo "ERROR: Could not retrieve atuin sync address from Bitwarden" >&2
    exit 1
fi
"${ATUIN_BIN}" config set sync_address "${ATUIN_SYNC_ADDRESS}"
echo "Atuin sync address set to ${ATUIN_SYNC_ADDRESS}."

# --- 2. Login ---
if "${ATUIN_BIN}" account info &>/dev/null; then
    echo "Atuin already logged in, skipping login."
else
    ATUIN_USERNAME=$(bw_get "atuin-account" ".login.username")
    ATUIN_PASSWORD=$(bw_get "atuin-account" ".login.password")
    ATUIN_KEY=$(bw_get "atuin-key" ".login.password")

    if [ -z "${ATUIN_USERNAME}" ] || [ "${ATUIN_USERNAME}" = "null" ] \
    || [ -z "${ATUIN_PASSWORD}" ] || [ "${ATUIN_PASSWORD}" = "null" ] \
    || [ -z "${ATUIN_KEY}" ]      || [ "${ATUIN_KEY}" = "null" ]; then
        echo "ERROR: Could not retrieve atuin credentials from Bitwarden" >&2
        exit 1
    fi

    "${ATUIN_BIN}" login -u "${ATUIN_USERNAME}" -p "${ATUIN_PASSWORD}" -k "${ATUIN_KEY}"
    echo "Atuin login complete."
fi

# --- 3. Sync ---
"${ATUIN_BIN}" sync
echo "Atuin sync enabled."

{{ end -}}
