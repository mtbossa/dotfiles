{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

cleanup() {
    bw lock &>/dev/null || true
    unset BW_SESSION 2>/dev/null || true
}
trap cleanup EXIT

if ! command -v atuin &>/dev/null; then
    echo "ERROR: atuin is not installed" >&2
    exit 1
fi

# --- Login ---
if atuin account info &>/dev/null; then
    echo "Atuin already logged in, skipping login."
else
    echo "Unlocking Bitwarden..."
    if ! bw login --check &>/dev/null; then
        BW_SESSION=$(bw login --raw)
    else
        BW_SESSION=$(bw unlock --raw)
    fi
    export BW_SESSION

    ATUIN_USERNAME=$(bw get username atuin --session "${BW_SESSION}")
    ATUIN_PASSWORD=$(bw get password atuin --session "${BW_SESSION}")
    ATUIN_KEY=$(bw get password atuin-key --session "${BW_SESSION}")
    ATUIN_SYNC_ADDRESS=$(bw get password atuin-server --session "${BW_SESSION}")

    atuin login -u "${ATUIN_USERNAME}" -p "${ATUIN_PASSWORD}" -k "${ATUIN_KEY}"
    echo "Atuin login complete."
fi

# --- Sync address (idempotent) ---
ATUIN_SYNC_ADDRESS=$(bw get password atuin-server --session "${BW_SESSION:-}")
if [ -n "${ATUIN_SYNC_ADDRESS}" ]; then
    atuin config set sync_address "${ATUIN_SYNC_ADDRESS}"
    echo "Atuin sync address set."
fi

atuin sync
echo "Atuin sync enabled."

{{ end -}}
