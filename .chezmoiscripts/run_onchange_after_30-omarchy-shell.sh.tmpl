{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") -}}
#!/bin/bash
# Hook our extras into Omarchy's ~/.bashrc without owning the file.
set -euo pipefail

LINE='[[ -f ~/.config/shell/omarchy-extras.bash ]] && source ~/.config/shell/omarchy-extras.bash'
if ! grep -qF 'omarchy-extras.bash' "${HOME}/.bashrc" 2>/dev/null; then
    printf '\n# dotfiles extras (atuin, personal aliases)\n%s\n' "${LINE}" >> "${HOME}/.bashrc"
fi
{{ end -}}
