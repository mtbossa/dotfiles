{{ if and (eq .chezmoi.os "linux") .registerWireguard -}}
#!/bin/bash
# chezmoi re-runs this if the hostname changes (peer name is baked in the hash comment below)
# config hash: {{ .chezmoi.hostname }}
set -euo pipefail

exec ~/.local/bin/register-wireguard --peer-name "{{ .chezmoi.hostname }}"
{{ end -}}
