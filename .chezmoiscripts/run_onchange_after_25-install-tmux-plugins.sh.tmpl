#!/bin/bash
# Installs the TPM plugins declared in ~/.config/tmux/tmux.conf. Re-runs when tmux.conf changes.
# Numbered after the Ansible playbook (20) so tmux exists on Debian-family machines.
# tmux.conf hash: {{ include "private_dot_config/tmux/tmux.conf" | sha256sum }}
set -euo pipefail

command -v tmux &>/dev/null || { echo "tmux not installed; skipping TPM plugins" >&2; exit 0; }
"${HOME}/.config/tmux/plugins/tpm/bin/install_plugins"
