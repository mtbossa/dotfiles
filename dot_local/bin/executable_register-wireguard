#!/bin/bash
# register-wireguard -- register this machine as a WireGuard peer via WGD API.
#
# Usage:
#   register-wireguard [--peer-name NAME]
#
# When called without arguments, PEER_NAME defaults to the system hostname.
# All secrets are fetched from a Bitwarden item named "wg-bootstrap".
#
# Can be run standalone (outside chezmoi) as long as `bw` and `jq` are available.

set -euo pipefail

# ---------------------------------------------------------------------------
# Args
# ---------------------------------------------------------------------------
PEER_NAME="${1:-}"
if [ -z "${PEER_NAME}" ]; then
    PEER_NAME="$(hostname)"
fi

# Parse --peer-name NAME
while [[ $# -gt 0 ]]; do
    case "$1" in
        --peer-name)
            PEER_NAME="$2"
            shift 2
            ;;
        *)
            echo "Unknown argument: $1" >&2
            echo "Usage: register-wireguard [--peer-name NAME]" >&2
            exit 1
            ;;
    esac
done

BW_ITEM="wg-bootstrap"
TMP_DIR=$(mktemp -d -t wg-bootstrap.XXXXXX)
TMP_KEY="${TMP_DIR}/id"
TUNNEL_PID=""

# ---------------------------------------------------------------------------
# Cleanup
# ---------------------------------------------------------------------------
cleanup() {
    [ -n "${TUNNEL_PID}" ] && kill "${TUNNEL_PID}" 2>/dev/null || true
    if [ -d "${TMP_DIR}" ]; then
        find "${TMP_DIR}" -type f -exec shred -u {} \; 2>/dev/null || true
        rm -rf "${TMP_DIR}"
    fi
    unset BW_SESSION API_KEY 2>/dev/null || true
}
trap cleanup EXIT

# ---------------------------------------------------------------------------
# 1. Unlock Bitwarden (same logic as bw-unlock chezmoi template)
# ---------------------------------------------------------------------------
BW_SESSION_FILE="/tmp/chezmoi-bw-session-${UID}"

_load_cached_bw_session() {
    [ -r "${BW_SESSION_FILE}" ] || return 1
    BW_SESSION=$(cat "${BW_SESSION_FILE}")
    [ -n "${BW_SESSION}" ] || return 1
    bw status --session "${BW_SESSION}" 2>/dev/null | grep -q '"status":"unlocked"' || return 1
    export BW_SESSION
    return 0
}

if ! _load_cached_bw_session; then
    echo "Unlocking Bitwarden..."
    if ! bw login --check &>/dev/null; then
        BW_SESSION=$(bw login --raw)
    else
        BW_SESSION=$(bw unlock --raw)
    fi
    (umask 077 && printf '%s' "${BW_SESSION}" > "${BW_SESSION_FILE}")
    export BW_SESSION
fi

# ---------------------------------------------------------------------------
# 2. Fetch the bootstrap item
# ---------------------------------------------------------------------------
echo "Fetching '${BW_ITEM}' from Bitwarden..."
ITEM_JSON=$(bw get item "${BW_ITEM}" --session "${BW_SESSION}")

get_field() {
    jq -r --arg n "$1" '.fields[] | select(.name==$n) | .value' <<<"${ITEM_JSON}"
}

SSH_HOST=$(get_field ssh_host)
SSH_PORT=$(get_field ssh_port)
SSH_USER=$(get_field ssh_user)
API_KEY=$(get_field api_key)
WG_IFACE=$(get_field wg_interface)

for var in SSH_HOST SSH_PORT SSH_USER API_KEY WG_IFACE; do
    val="${!var}"
    if [ -z "${val}" ] || [ "${val}" = "null" ]; then
        echo "ERROR: Bitwarden item '${BW_ITEM}' is missing custom field '${var,,}'" >&2
        exit 1
    fi
done

WG_CONF="/etc/wireguard/${WG_IFACE}.conf"

# ---------------------------------------------------------------------------
# 3. Skip if already configured
# ---------------------------------------------------------------------------
if sudo test -f "${WG_CONF}"; then
    echo "${WG_CONF} already exists; skipping WireGuard registration."
    exit 0
fi

# ---------------------------------------------------------------------------
# 4. Fetch the SSH bootstrap key from the secure note body
# ---------------------------------------------------------------------------
echo "Fetching SSH bootstrap key..."
umask 077
bw get notes "${BW_ITEM}" --session "${BW_SESSION}" > "${TMP_KEY}"

# Bitwarden commonly strips the trailing newline; OpenSSH then refuses to
# load the key with "error in libcrypto" and falls through to password auth.
if [ -n "$(tail -c 1 "${TMP_KEY}")" ]; then
    printf '\n' >> "${TMP_KEY}"
fi
chmod 600 "${TMP_KEY}"

if ! ssh-keygen -y -f "${TMP_KEY}" >/dev/null 2>&1; then
    echo "ERROR: Bitwarden note '${BW_ITEM}' does not contain a parseable SSH private key" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# 5. Open the SSH tunnel to the WGD LXC
# ---------------------------------------------------------------------------
echo "Opening SSH tunnel to ${SSH_USER}@${SSH_HOST}:${SSH_PORT}..."
ssh -i "${TMP_KEY}" -f -N \
    -p "${SSH_PORT}" \
    -L 10086:127.0.0.1:10086 \
    -o ExitOnForwardFailure=yes \
    -o StrictHostKeyChecking=accept-new \
    -o UserKnownHostsFile="${TMP_DIR}/known_hosts" \
    -o ConnectTimeout=15 \
    -o ServerAliveInterval=10 \
    "${SSH_USER}@${SSH_HOST}"
TUNNEL_PID=$(pgrep -f "ssh.*-L 10086:127.0.0.1:10086.*${SSH_USER}@${SSH_HOST}" | head -1)
[ -z "${TUNNEL_PID}" ] && { echo "ERROR: could not locate backgrounded ssh tunnel" >&2; exit 1; }

for _ in $(seq 1 10); do
    if (echo >/dev/tcp/127.0.0.1/10086) 2>/dev/null; then break; fi
    sleep 1
done

# ---------------------------------------------------------------------------
# 6. Register the peer via WGD API
# ---------------------------------------------------------------------------
echo "Registering peer '${PEER_NAME}' with WGD API..."
PAYLOAD=$(jq -n --arg name "${PEER_NAME}" '{name: $name}')

ADD_RESPONSE=$(curl -sS -X POST \
    "http://127.0.0.1:10086/api/addPeers/${WG_IFACE}" \
    -H "wg-dashboard-apikey: ${API_KEY}" \
    -H "Content-Type: application/json" \
    -d "${PAYLOAD}")

if ! jq -e '.status == true' <<<"${ADD_RESPONSE}" >/dev/null 2>&1; then
    echo "ERROR: WGD API rejected addPeers request:" >&2
    jq . <<<"${ADD_RESPONSE}" >&2 || echo "${ADD_RESPONSE}" >&2
    exit 1
fi

PEER_PUB=$(jq -r '.data[0].id' <<<"${ADD_RESPONSE}")
if [ -z "${PEER_PUB}" ] || [ "${PEER_PUB}" = "null" ]; then
    echo "ERROR: could not read peer id from addPeers response:" >&2
    jq . <<<"${ADD_RESPONSE}" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# 7. Download the rendered peer config
# ---------------------------------------------------------------------------
echo "Downloading rendered peer config..."
ENCODED_KEY=$(jq -rn --arg v "${PEER_PUB}" '$v|@uri')
DL_RESPONSE=$(curl -sS \
    "http://127.0.0.1:10086/api/downloadPeer/${WG_IFACE}?id=${ENCODED_KEY}" \
    -H "wg-dashboard-apikey: ${API_KEY}")

FINAL_CONFIG=$(jq -r '.data.file // empty' <<<"${DL_RESPONSE}")
if [ -z "${FINAL_CONFIG}" ]; then
    echo "ERROR: could not extract config from downloadPeer response:" >&2
    jq . <<<"${DL_RESPONSE}" >&2 || echo "${DL_RESPONSE}" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# 8. Write config
# ---------------------------------------------------------------------------
echo "Writing ${WG_CONF}..."
sudo install -m 600 -o root -g root /dev/null "${WG_CONF}"
printf '%s\n' "${FINAL_CONFIG}" | sudo tee "${WG_CONF}" >/dev/null

echo ""
echo "WireGuard peer '${PEER_NAME}' registered."
echo "Config written to ${WG_CONF}. Bring the interface up with:"
echo "    sudo wg-quick up ${WG_IFACE}"
echo "Or enable on boot with:"
echo "    sudo systemctl enable --now wg-quick@${WG_IFACE}"
